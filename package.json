{
  "name": "net-watch-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency 20",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "example:vanilla": "pnpm --filter @net-watch/example-vanilla dev",
    "example:react": "pnpm --filter @net-watch/example-react dev",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "version-packages:beta": "changeset version --snapshot beta",
    "release": "pnpm build && changeset publish",
    "release:beta": "pnpm build && changeset publish --tag beta --no-git-tag"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@tsconfig/strictest": "catalog:",
    "turbo": "^2.11.8",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
