{
  "name": "net-watch",
  "type": "module",
  "version": "0.0.0",
  "description": "Is the user really online, and how good is the connection? Zero-dependency core with React/Vue/Angular adapters",
  "author": "dangminhkhoi2212",
  "license": "MIT",
  "homepage": "https://github.com/dangminhkhoi2212/net-watch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dangminhkhoi2212/net-watch.git"
  },
  "bugs": {
    "url": "https://github.com/dangminhkhoi2212/net-watch/issues"
  },
  "exports": {
    ".": "./dist/index.js",
    "./react": "./dist/react.js",
    "./vue": "./dist/vue.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "play": "vite",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "^4.1.10",
    "bumpp": "^11.1.0",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.22.5",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0",
    "vue": "^3.5.43"
  },
  "sideEffects": false,
  "peerDependencies": {
    "@angular/core": ">=17",
    "react": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    }
  }
}
