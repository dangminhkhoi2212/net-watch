{
  "name": "@net-watch/react",
  "version": "0.2.0",
  "description": "React hook useNetworkStatus() for real online/offline detection and connection quality (latency, speed). Built on @net-watch/core.",
  "keywords": [
    "network-status",
    "online",
    "offline",
    "offline-detection",
    "connectivity",
    "network-quality",
    "connection-speed",
    "latency",
    "navigator-online",
    "network-information-api",
    "banner",
    "typescript",
    "zero-dependency",
    "react",
    "react-hook",
    "use-network-status",
    "useNetworkStatus",
    "useSyncExternalStore"
  ],
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "dangminhkhoi2212",
  "homepage": "https://net-watch-docs.vercel.app",
  "bugs": "https://github.com/dangminhkhoi2212/net-watch/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dangminhkhoi2212/net-watch.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo dist"
  },
  "dependencies": {
    "@net-watch/core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts"
}
