{
  "name": "@net-watch/angular",
  "version": "0.1.1",
  "description": "Angular signal injectNetworkStatus() for real online/offline detection and connection quality (latency, speed). Built on @net-watch/core.",
  "keywords": [
    "network-status",
    "online",
    "offline",
    "offline-detection",
    "connectivity",
    "network-quality",
    "connection-speed",
    "latency",
    "navigator-online",
    "network-information-api",
    "banner",
    "typescript",
    "zero-dependency",
    "angular",
    "angular-signals",
    "signal",
    "inject-network-status",
    "injectNetworkStatus"
  ],
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "dangminhkhoi2212",
  "homepage": "https://net-watch-docs.vercel.app",
  "bugs": "https://github.com/dangminhkhoi2212/net-watch/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dangminhkhoi2212/net-watch.git",
    "directory": "packages/angular"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo dist"
  },
  "dependencies": {
    "@net-watch/core": "workspace:^"
  },
  "peerDependencies": {
    "@angular/core": ">=17"
  },
  "devDependencies": {
    "@angular/compiler": "catalog:",
    "@angular/core": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "rxjs": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
