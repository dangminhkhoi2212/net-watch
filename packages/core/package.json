{
  "name": "@net-watch/core",
  "version": "0.2.0",
  "description": "Detect if the user is really online (not just Wi-Fi on) and measure connection quality: latency, speed and an offline banner. Zero dependencies, works in Chrome, Firefox and Safari.",
  "keywords": [
    "network-status",
    "online",
    "offline",
    "offline-detection",
    "connectivity",
    "network-quality",
    "connection-speed",
    "latency",
    "navigator-online",
    "network-information-api",
    "banner",
    "typescript",
    "zero-dependency",
    "internet-connection",
    "is-online",
    "ping",
    "rtt",
    "downlink",
    "effective-type",
    "fetch",
    "safari",
    "firefox",
    "ssr"
  ],
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "dangminhkhoi2212",
  "homepage": "https://net-watch-docs.vercel.app",
  "bugs": "https://github.com/dangminhkhoi2212/net-watch/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dangminhkhoi2212/net-watch.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo dist"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./banner": {
      "import": "./dist/banner.js",
      "require": "./dist/banner.cjs"
    },
    "./fetch": {
      "import": "./dist/fetch.js",
      "require": "./dist/fetch.cjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "banner": [
        "./dist/banner.d.cts"
      ],
      "fetch": [
        "./dist/fetch.d.cts"
      ]
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts"
}
